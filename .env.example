# Copy this file to .env and fill it in. NEVER commit .env
LLM_API_KEY=
# Optional: openai | anthropic | gemini | groq | openrouter (auto-detected from the key)
LLM_PROVIDER=
# Optional: exact model name (run "npm run check-key" to find one)
LLM_MODEL=
# Optional: only if the company gave a custom API URL (OpenAI-compatible)
LLM_BASE_URL=
# Long random text. Make one with:  openssl rand -hex 32
APP_SECRET=
# Upstash Redis (required on Vercel, optional on your laptop)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Successful scorings allowed per IP per hour
RATE_LIMIT_PER_HOUR=5
